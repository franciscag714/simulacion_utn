		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1754506500914">
			<Id>1761508792778</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[excelFile.readFile();

String[] politicas = {
    "Politica sQ Normal" ,"Politica sQ Optimista","Politica sQ Pesimista", 
    "Política sS Normal", "Política sS Optimista","Política sS Pesimista",
    "Politica sI Normal","Politica sI Optimista","Politica sI Pesimista",
    "Politica 0S Normal", "Politica 0S Optimista", "Politica 0S Pesimista",
    "Politica qR Normal","Politica qR Optimista","Politica qR Pesimista"
};
String[] costos = {
    "Costo total mensual", "Costo mantenimiento mensual", "Costo faltante mensual",
    "Costo pedido mensual",  "Ganancia promedio", "Ganancia mensual"
};
String[] cantidades_pedidas = {
    "KWID","LOGAN","CAPTUR",
    "KANGOO","ALASKAN"
};
String[] inventarios = {
    "Inventario KWID", "Inventario LOGAN", "Inventario CAPTUR",
    "Inventario KANGOO", "Inventario ALASKAN"
};

int desplazamientoCostos = 190;
int desplazamientoCantidades = 200;
int desplazamientoInventarios = 200;
excelFile.setCellValue("Replica: " + 1, 4, 1, 1); 
excelFile.setCellValue("Replica: " + 1, 5, 1, 1); 
excelFile.setCellValue("Replica: " + 1, 6, 1, 1); 

for (int replication = 1; replication <= 40; replication++) { 

	excelFile.setCellValue("Replica: " + (replication + 1), 4, 1, replication*190 + 1); 
    for (int i = 0; i < politicas.length; i++){ 
        excelFile.setCellValue(politicas[i], 4, 2, desplazamientoCostos * (replication - 1) + i * 12 + 1); 
        for(int j = 0; j < costos.length; j++){ 
            excelFile.setCellValue(costos[j], 4, 3, desplazamientoCostos * (replication - 1) + i * 12 + j * 2 + 1); 
        } 
    }

    // Hoja 5 - Cantidades pedidas
    excelFile.setCellValue("Replica: " + (replication + 1), 5, 1, replication*200 + 1); 
    for (int a = 0; a < cantidades_pedidas.length; a++){
        excelFile.setCellValue(cantidades_pedidas[a], 5, 2, desplazamientoCantidades * (replication - 1) + 30 * a + 1);
        for(int b = 0; b < politicas.length; b++){
            excelFile.setCellValue(politicas[b], 5, 3, desplazamientoCantidades * (replication - 1) + b * 2 + 30 * a + 1);
        }
    }

    // Hoja 6 - Inventarios
	excelFile.setCellValue("Replica: " + (replication + 1), 6, 1, replication*200 + 1); 
    for (int c = 0; c < inventarios.length; c++){
        excelFile.setCellValue(inventarios[c], 6, 2, desplazamientoInventarios * (replication - 1) + c * 30 + 1);
        for(int d = 0; d < politicas.length; d++){
            excelFile.setCellValue(politicas[d], 6, 3, desplazamientoInventarios * (replication - 1) + c * 30 + d * 2 + 1);
        }
    }
}]]></InitialSetupCode>
			<MaximumMemory>16384</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[excelFile.writeDataSet(root.costo_total_mensual_ds, 4, 4, ((getCurrentIteration()-1)*12+1)+190*(getCurrentReplication()-1));
excelFile.writeDataSet(root.costo_mantenimiento_mensual_ds, 4, 4, ((getCurrentIteration()-1)*12+3)+190*(getCurrentReplication()-1));
excelFile.writeDataSet(root.costo_faltante_mensual_ds, 4, 4, ((getCurrentIteration()-1)*12+5)+190*(getCurrentReplication()-1));
excelFile.writeDataSet(root.costo_pedido_mensual_ds, 4, 4, ((getCurrentIteration()-1)*12+7)+190*(getCurrentReplication()-1));
excelFile.writeDataSet(root.ganancia_promedio_ds, 4, 4, ((getCurrentIteration()-1)*12+9)+190*(getCurrentReplication()-1));
excelFile.writeDataSet(root.ganancia_mensual_ds, 4, 4, ((getCurrentIteration()-1)*12+11)+190*(getCurrentReplication()-1));
excelFile.writeDataSet(root.cantidad_pedida_kwid, 5, 4, ((getCurrentIteration()*2)-1)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.cantidad_pedida_logan, 5, 4, ((getCurrentIteration()*2)+29)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.cantidad_pedida_captur, 5, 4, ((getCurrentIteration()*2)+59)+200*(getCurrentReplication()));
excelFile.writeDataSet(root.cantidad_pedida_kangoo, 5, 4, ((getCurrentIteration()*2)+89)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.cantidad_pedida_alaskan, 5, 4, ((getCurrentIteration()*2)+119)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.inventario_kwid_ds, 6, 4, ((getCurrentIteration()*2)-1)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.inventario_logan_ds, 6, 4, ((getCurrentIteration()*2)+29)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.inventario_captur_ds, 6, 4, ((getCurrentIteration()*2)+59)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.inventario_kangoo_ds, 6, 4, ((getCurrentIteration()*2)+89)+200*(getCurrentReplication()-1));
excelFile.writeDataSet(root.inventario_alaskan_ds, 6, 4, ((getCurrentIteration()*2)+119)+200*(getCurrentReplication()-1));


]]></AfterSimulationRunCode>
