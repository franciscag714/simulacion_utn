alaskan_no_vendidos_mes_anterior = alaskan_no_vendidos;
captur_no_vendidos_mes_anterior = captur_no_vendidos;

costo_faltante_mensual = (precio_kwid - costo_kwid)*kwid_no_vendidos + (precio_logan - costo_logan)*logan_no_vendidos + (precio_kangoo - costo_kangoo) * kangoo_no_vendidos + (precio_alaskan - costo_alaskan)* alaskan_no_vendidos + (precio_captur - costo_captur)* captur_no_vendidos;
costo_faltante_acumulado += costo_faltante_mensual;
costo_mantenimiento_mensual_no_vendidos =  costo_mantenimiento_kwid_mensual * kwid_no_vendidos 
+ costo_mantenimiento_logan_mensual * logan_no_vendidos
+costo_mantenimiento_captur_mensual * captur_no_vendidos
+costo_mantenimiento_alaskan_mensual * alaskan_no_vendidos
+costo_mantenimiento_kangoo_mensual * kangoo_no_vendidos; 

kwid_no_vendidos = 0;
logan_no_vendidos = 0;
alaskan_no_vendidos = 0;
