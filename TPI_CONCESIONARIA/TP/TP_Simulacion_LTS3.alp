					<Action><![CDATA[costo_mantenimiento_kangoo_mensual = calcularCostosVehiculoMensual(precio_kangoo);
costo_mantenimiento_captur_mensual = calcularCostosVehiculoMensual(precio_captur);
costo_mantenimiento_alaskan_mensual = calcularCostosVehiculoMensual(precio_alaskan);
