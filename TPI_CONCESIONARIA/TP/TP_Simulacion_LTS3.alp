					<Action><![CDATA[double valor = 0.0;
if(schedule_seleccionado.equals("schedule_normal")){
	valor = (double) schedule.getValue(time()); // usa el valor actual
}else if(schedule_seleccionado.equals("schedule_pesimista")){
	valor = (double) schedule.getValue(time()) * 1.5; // usa el valor actual + 50%
}else {
	valor = (double) schedule.getValue(time()) * 0.5; // usa el valor actual - 50 %
}
double p = (double)(contador_clientes_reingreso / contador_clientes_unicos);
double pIngresoNuevo = (1-p);
double nEntrada = (double) Math.round(valor * pIngresoNuevo);
double nReingreso = valor - nEntrada;
for (int i = 0; i < nEntrada; i++) entrada_cliente.inject();
for (int i = 0; i < nReingreso; i++) reingreso.inject();]]></Action>
