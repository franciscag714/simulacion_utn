			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1757967417864</Id>
					<Name><![CDATA[evaluando]]></Name>
					<X>430</X><Y>160</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="140" Height="60">
						<ExitAction><![CDATA[seDecideComprar = randomTrue(poderAdquisitivo);
if(seDecideComprar){
	auto_a_comprar = calcular_auto();
}if (reingreso == null) {
    main.contador_clientes_unicos++;
    reingreso = false;
} 
else if (reingreso == false) {
    reingreso = true;
    main.contador_clientes_reingreso++;
}

main.evaluando.stopDelay(this);]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
