				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1758135704055</Id>
					<Name><![CDATA[quiere_comprar]]></Name>
					<X>320</X><Y>260</Y>
					<Label><X>0</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="120" Height="60">
						<EntryAction><![CDATA[switch (auto_a_comprar) {
    case "kwid":
        main.demanda_kwid++;
        numero_demanda = main.demanda_kwid;
        break;
    case "logan":
        main.demanda_logan++;
        numero_demanda = main.demanda_logan;
        break;
    case "alaskan":
        main.demanda_alaskan++;
