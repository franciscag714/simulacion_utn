			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761414653755</Id>
					<Name><![CDATA[calcularCostosVehiculoMensual]]></Name>
					<X>40</X><Y>-700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valorAuto]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double tasaInteresMensual = 0.01; // 1% mensual
double costoFinancieroMensual = valorAuto * tasaInteresMensual;

double costoSeguroMensual = calcularCostoSeguroMensual(valorAuto);

double costoTotalMensual = costoFinancieroMensual + costoSeguroMensual;

return costoTotalMensual;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761414878881</Id>
					<Name><![CDATA[calcularCostoSeguroMensual]]></Name>
					<X>40</X><Y>-670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[valorAuto]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[    double primaAnual = valorAuto * 0.021; 
    return primaAnual / 12; // Mensual]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761510571204</Id>
					<Name><![CDATA[crearAutos]]></Name>
					<X>250</X><Y>-670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[cantKwid]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cantLogan]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cantCaptur]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cantKangoo]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[cantAlaskan]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[esReposicion]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[int kwid = (int)cantKwid; 
int logan = (int)cantLogan; 
int captur = (int)cantCaptur; 
int kangoo = (int)cantKangoo; 
int alaskan = (int)cantAlaskan; 
int totalAutos = kwid + logan + captur + kangoo + alaskan; 
if (totalAutos > 0) {
	double separacionX = 100; 
	double separacionY = 50; 
	int autosPorFila = (int)(galpon.getWidth() / separacionX); 
	int inicio = 0; 
if (esReposicion) {
	inicio = autos.size(); 
} 
for (int i = 0; i < totalAutos; i++) { 
   Auto a = add_autos(); 
   
   int indiceGlobal = inicio + i; 
   int fila = indiceGlobal / autosPorFila; 
   int columna = indiceGlobal % autosPorFila; 
   double x = galpon.getX() + columna * separacionX + separacionX / 2; 
   double y = galpon.getY() + fila * separacionY + separacionY / 2; a.setXY(x, y);
    if (i < kwid) { 
	    a.modelo = "Kwid"; 
	    a.carShape.setFillColor(Color.orange); 
	} 
    else if (i < kwid + logan) { 
	    a.modelo = "Logan"; 
	    a.carShape.setFillColor(Color.blue); 
    } else if (i < kwid + logan + captur) { 
	    a.modelo = "Captur";
	    a.carShape.setFillColor(Color.red); 
     } 
     else if (i < kwid + logan + captur + kangoo) { 
	     a.modelo = "Kangoo";
	     a.carShape.setFillColor(Color.green);
     } else { 
       a.modelo = "Alaskan"; 
       a.carShape.setFillColor(Color.gray); 
     } 
   } 
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761510708185</Id>
					<Name><![CDATA[eliminarAutoPorModelo]]></Name>
					<X>250</X><Y>-701.25</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[modelo]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[
for (int i = 0; i < autos.size(); i++) {
    Auto auto = autos.get(i);
    if (auto.modelo.equals(modelo)) {
        remove_autos(auto);
        break; 
    }
}]]></Body>
				</Function>
			</Functions>
