					<Properties Source="1759869336553" Target="1758135859815" Trigger="timeout">
						<Action><![CDATA[seDecideComprar = false;
switch (auto_a_comprar) {
    case "kwid":
        main.demanda_kwid--;
        main.kwid_no_vendidos++;
	    break;
    case "logan":
        main.demanda_logan--;
        main.logan_no_vendidos++;
	    break;
    case "kangoo":
        main.demanda_kangoo--;
        main.kangoo_no_vendidos++;
	    break;
    case "alaskan":
        main.demanda_alaskan--;
        main.alaskan_no_vendidos++;
	    break;
    case "captur":
        main.demanda_captur--;
        main.captur_no_vendidos++;
	    break;
}]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[uniform(2, 5)]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</Timeout>
						<Condition><![CDATA[true]]></Condition>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_WEEK]]></Unit>
						</Rate>
						<Guard><![CDATA[(auto_a_comprar == "kwid" && main.inventario_kwid == 0) ||(auto_a_comprar == "logan" && main.inventario_logan == 0) || (auto_a_comprar == "kangoo" && main.inventario_kangoo == 0) || (auto_a_comprar == "alaskan" && main.inventario_alaskan == 0) || (auto_a_comprar == "captur" && main.inventario_captur == 0)]]></Guard>
						<MessageType><![CDATA[Object]]></MessageType>
