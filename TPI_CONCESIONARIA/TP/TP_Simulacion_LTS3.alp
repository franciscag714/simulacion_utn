					</Properties>
					<Action><![CDATA[double serviciosPublicos = triangular(1500000, 5000000, 3000000);
double sueldoPersonalPromedio = triangular(950000, 2500000, 1500000);
double alquilerTerreno = 9300000;
costo_mantenimiento_mensual = (costo_mantenimiento_kwid_mensual * inventario_kwid_estadistica.mean()) + (costo_mantenimiento_logan_mensual * inventario_logan_estadistica.mean())+(costo_mantenimiento_captur_mensual * inventario_captur_estadistica.mean())+(costo_mantenimiento_alaskan_mensual * inventario_alaskan_estadistica.mean())+(costo_mantenimiento_kangoo_mensual * inventario_kangoo_estadistica.mean()) + serviciosPublicos + 15*sueldoPersonalPromedio + alquilerTerreno;
costo_mantenimiento_mensual_acumulado = costo_mantenimiento_mensual_acumulado + costo_mantenimiento_mensual;
inventario_kwid_estadistica.reset();
inventario_logan_estadistica.reset();
inventario_alaskan_estadistica.reset();
inventario_captur_estadistica.reset();
inventario_kangoo_estadistica.reset();]]></Action>
