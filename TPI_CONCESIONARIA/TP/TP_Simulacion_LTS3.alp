					<ValueType>double_</ValueType>
					<UnitType><![CDATA[RATE]]></UnitType>
					<UnitOfValue Class="RateUnits"><![CDATA[PER_WEEK]]></UnitOfValue>
					<DefaultValue>0.0</DefaultValue>
