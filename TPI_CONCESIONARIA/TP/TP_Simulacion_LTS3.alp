			<Events>
				<Event>
					<Id>1758309489175</Id>
					<Name><![CDATA[inventario_mensual_checkeo]]></Name>
					<X>160</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_WEEK]]></Unit>
						</Rate>
						<Id>1758309489173</Id>
						<OccurrenceAtTime>false</OccurrenceAtTime>
						<OccurrenceDate>1761811200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[4]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (pedido_pendiente == false && !politicaInventario.equals("qR")) {
	int total_autos = 0;
	int cant_camiones = 0;	
	costo_pedido_mensual = 0;
	stock_solicitado_kwid = 0;
	stock_solicitado_logan = 0;
	stock_solicitado_alaskan = 0;
	stock_solicitado_kangoo = 0;
	stock_solicitado_captur = 0;
	switch (politicaInventario) {
		case "sQ": // Política (s, Q) mejorada
		    double factorSeguridad = 1.25; 
		    
		    if (inventario_kwid < punto_reposicion_kwid) {
		        double demanda_promedio = demanda_kwid_estadistica.mean();
		        double deficit = punto_reposicion_kwid - inventario_kwid;
		        stock_solicitado_kwid = Math.round(demanda_promedio * factorSeguridad + deficit);
		        
		        //costo_pedido_mensual += costo_kwid * stock_solicitado_kwid;
		    }
		    
		    if (inventario_logan < punto_reposicion_logan) {
		        double demanda_promedio = demanda_logan_estadistica.mean();
		        double deficit = punto_reposicion_logan - inventario_logan;
		        stock_solicitado_logan = Math.round(demanda_promedio * factorSeguridad + deficit);
		        
		        //costo_pedido_mensual += costo_logan * stock_solicitado_logan;
		    }
		    
		    if (inventario_kangoo < punto_reposicion_kangoo) {
		        double demanda_promedio = demanda_kangoo_estadistica.mean();
		        double deficit = punto_reposicion_kangoo - inventario_kangoo;
		        stock_solicitado_kangoo = Math.round(demanda_promedio * factorSeguridad + deficit);
		        
		        //costo_pedido_mensual += costo_kangoo * stock_solicitado_kangoo;
		    } 
		    
		    if (inventario_captur < punto_reposicion_captur) {
		        double demanda_promedio = demanda_captur_estadistica.mean();
		        double deficit = punto_reposicion_captur - inventario_captur;
		        stock_solicitado_captur = Math.round(demanda_promedio * factorSeguridad + deficit);
		        
		        //costo_pedido_mensual += costo_captur * stock_solicitado_captur;
		    } 
		    
		    if (inventario_alaskan < punto_reposicion_alaskan) {
		        double demanda_promedio = demanda_alaskan_estadistica.mean();
		        double deficit = punto_reposicion_alaskan - inventario_alaskan;
		        stock_solicitado_alaskan = Math.round(demanda_promedio * factorSeguridad + deficit);
		        
		        //costo_pedido_mensual += costo_alaskan * stock_solicitado_alaskan;
		    }
		    
		    if ((stock_solicitado_kwid + stock_solicitado_logan + stock_solicitado_captur + stock_solicitado_alaskan + stock_solicitado_kangoo) > 0) {
		    	costo_pedido_mensual += costoFijo;
		    }
		    cantidad_pedida_kwid.add(stock_solicitado_kwid);
		    cantidad_pedida_logan.add(stock_solicitado_logan);
		    cantidad_pedida_captur.add(stock_solicitado_captur);
		    cantidad_pedida_alaskan.add(stock_solicitado_alaskan);
		    cantidad_pedida_kangoo.add(stock_solicitado_kangoo);
		    break;

		case "sS": // Política (s, S)
			
			if (inventario_kwid < punto_reposicion_kwid) {
				stock_solicitado_kwid = S_kwid - inventario_kwid;
				//costo_pedido_mensual += costo_kwid * stock_solicitado_kwid;
			}
			if (inventario_logan < punto_reposicion_logan) {
				stock_solicitado_logan = S_logan - inventario_logan;
				//costo_pedido_mensual += costo_logan * stock_solicitado_logan;
			} 
			if (inventario_kangoo < punto_reposicion_kangoo) {
				stock_solicitado_kangoo = S_kangoo - inventario_kangoo;
				//costo_pedido_mensual += costo_kangoo * stock_solicitado_kangoo;
			} 
			if (inventario_captur < punto_reposicion_captur) {
				stock_solicitado_captur = S_captur - inventario_captur;
				//costo_pedido_mensual += costo_captur * stock_solicitado_captur;
			}
			if (inventario_alaskan < punto_reposicion_alaskan) {
				stock_solicitado_alaskan = S_alaskan - inventario_alaskan;
				//costo_pedido_mensual += costo_alaskan * stock_solicitado_alaskan;
			} 
			
 			if ((stock_solicitado_kwid + stock_solicitado_logan + stock_solicitado_captur + stock_solicitado_alaskan + stock_solicitado_kangoo) > 0) {
		    	costo_pedido_mensual += costoFijo;
		    }
			cantidad_pedida_kwid.add(stock_solicitado_kwid);
		    cantidad_pedida_logan.add(stock_solicitado_logan);
		    cantidad_pedida_captur.add(stock_solicitado_captur);
		    cantidad_pedida_alaskan.add(stock_solicitado_alaskan);
		    cantidad_pedida_kangoo.add(stock_solicitado_kangoo);
			break;

		case "sI": // Política (S - I) (ordenar hasta S siempre)
			
			stock_solicitado_kwid = Math.max(0, S_kwid - inventario_kwid);
			stock_solicitado_logan = Math.max(0, S_logan - inventario_logan);
			stock_solicitado_kangoo = Math.max(0, S_kangoo - inventario_kangoo);
			stock_solicitado_captur = Math.max(0, S_captur - inventario_captur);
			stock_solicitado_alaskan = Math.max(0, S_alaskan - inventario_alaskan);
			cantidad_pedida_kwid.add(stock_solicitado_kwid);
		    cantidad_pedida_logan.add(stock_solicitado_logan);
		    cantidad_pedida_captur.add(stock_solicitado_captur);
		    cantidad_pedida_alaskan.add(stock_solicitado_alaskan);
		    cantidad_pedida_kangoo.add(stock_solicitado_kangoo);
			
			costo_pedido_mensual += costoFijo;
			/*costo_kwid * stock_solicitado_kwid +
			costo_logan * stock_solicitado_logan +
			costo_kangoo * stock_solicitado_kangoo +
			costo_captur * stock_solicitado_captur +
			costo_alaskan * stock_solicitado_alaskan;*/
			break;
			
		case "0S": // Política de pedir cuando no hay mas stock, Pido hasta S
			if (inventario_kwid == 0) {
				stock_solicitado_kwid = S_kwid;
				//costo_pedido_mensual += costo_kwid * stock_solicitado_kwid;
			}
			if (inventario_logan == 0) {
				stock_solicitado_logan = S_logan;
				//costo_pedido_mensual += costo_logan * stock_solicitado_logan;
			} 
			if (inventario_kangoo == 0) {
				stock_solicitado_kangoo = S_kangoo;
				//costo_pedido_mensual += costo_kangoo * stock_solicitado_kangoo;
			} 
			if (inventario_captur == 0) {
				stock_solicitado_captur = S_captur;
				//costo_pedido_mensual += costo_captur * stock_solicitado_captur;
			}
			if (inventario_alaskan == 0) {
				stock_solicitado_alaskan = S_alaskan;
				//costo_pedido_mensual += costo_alaskan * stock_solicitado_alaskan;
			} 
			
 			if ((stock_solicitado_kwid + stock_solicitado_logan + stock_solicitado_captur + stock_solicitado_alaskan + stock_solicitado_kangoo) > 0) {
		    	costo_pedido_mensual += costoFijo;
		    }
			cantidad_pedida_kwid.add(stock_solicitado_kwid);
		    cantidad_pedida_logan.add(stock_solicitado_logan);
		    cantidad_pedida_captur.add(stock_solicitado_captur);
		    cantidad_pedida_alaskan.add(stock_solicitado_alaskan);
		    cantidad_pedida_kangoo.add(stock_solicitado_kangoo);
			break;
	}
	total_autos = (int)(stock_solicitado_kwid + stock_solicitado_logan + stock_solicitado_captur + stock_solicitado_alaskan + stock_solicitado_kangoo);
	cant_camiones = (int)Math.ceil(total_autos / 12);
	costo_pedido_mensual += cant_camiones * costo_camion;
	// aplicar costo total acumulado y reponer inventario
	costo_pedido_mensual_acumulado += costo_pedido_mensual;
	//traceln("Costo acumulado: " + costo_pedido_mensual_acumulado);
	tiempo_reposicion = 2 + uniform(1, 2);
	pedido_pendiente = true;
	reposicion_inventario.restart(tiempo_reposicion);

}
]]></Action>
				</Event>
				<Event>
					<Id>1758318511141</Id>
					<Name><![CDATA[reposicion_inventario]]></Name>
					<X>160</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_WEEK]]></Unit>
						</Rate>
						<Id>1758318511139</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1761811200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[tiempo_reposicion]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (pedido_pendiente == true) {
    inventario_kwid = inventario_kwid + stock_solicitado_kwid;
    inventario_logan = inventario_logan + stock_solicitado_logan;
    inventario_alaskan = inventario_alaskan + stock_solicitado_alaskan;
    inventario_kangoo = inventario_kangoo + stock_solicitado_kangoo;
    inventario_captur = inventario_captur + stock_solicitado_captur;

    crearAutos(stock_solicitado_kwid, stock_solicitado_logan, stock_solicitado_captur, stock_solicitado_kangoo, stock_solicitado_alaskan, true);

    tiempo_reposicion = 0;
    pedido_pendiente = false;
}]]></Action>
				</Event>
