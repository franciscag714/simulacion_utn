			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1758137904282</Id>
					<Name><![CDATA[calcular_auto]]></Name>
					<X>60</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double num_gen = uniform(0,1);

if (claseSocial.equals("ClaseSocial.BAJA")) {
	for(int i = 0; i < autos_ponderacion_baja.size(); i++) {
		if(num_gen <= autos_ponderacion_baja.get(i)) {
			return autos_listado.get(i);
		}
	}
} else if (claseSocial.equals("ClaseSocial.MEDIA")) {
	for(int i = 0; i < autos_ponderacion_media.size(); i++) {
		if(num_gen <= autos_ponderacion_media.get(i)) {
			return autos_listado.get(i);
		}
	}
} else {
	for(int i = 0; i < autos_ponderacion_alta.size(); i++) {
		if(num_gen <= autos_ponderacion_alta.get(i)) {
			return autos_listado.get(i);
		}
	}
};

return null;]]></Body>
				</Function>
			</Functions>
